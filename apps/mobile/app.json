{
  "expo": {
    "name": "DahaMiz",
    "slug": "dahamiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dahamiz",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dahamiz.app",
      "requireFullScreen": false
    },
    "android": {
      "package": "com.dahamiz.app",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#315A43",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DahaMiz, seçtiğiniz çevre bildirimi için fotoğraf çekebilmeniz amacıyla kameraya erişir.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "DahaMiz, yalnızca bu rapora konum eklemeyi seçtiğinizde konumunuzu kullanır. Konumunuz arka planda izlenmez.",
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DahaMiz, seçtiğiniz fotoğraf ve videoları rapor taslağına ekleyebilmek için fotoğraf arşivinize erişir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
