NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173,http://127.0.0.1:4174
LOG_LEVEL=debug

# Database (requires local Docker PostgreSQL — see infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://dahamiz:dahamiz_dev@localhost:5432/dahamiz_dev
DATABASE_SSL=false

# Firebase Admin (real tokens are verified against this project)
# Local Auth Emulator: use project ID demo-dahamiz and set FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099.
FIREBASE_PROJECT_ID=demo-dahamiz
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Private media storage — upload authorization fails closed until configured.
GCS_PROJECT_ID=
GCS_BUCKET_EVIDENCE=
# Separate public bucket; Phase 5 will only publish reviewed derivatives here.
GCS_BUCKET_PUBLIC=
